# Earth Jukebox configuration — copy to `.env` only if you need live data.
# The demo is offline-first and runs with no keys at all.

# NASA FIRMS MAP_KEY (optional). Enables recent live thermal hotspots for
# /api/hotspots when a probe latitude/longitude is supplied. Get a free key at
# https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# FIRMS satellite source used for optional live hotspots.
# Defaults to VIIRS_SNPP_NRT.
# FIRMS_SOURCE=VIIRS_SNPP_NRT

# Set to 0 to disable live NASA POWER requests and always serve the prepared
# NASA cache. The UI then shows the CACHED NASA badge.
EARTH_JUKEBOX_LIVE=1

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Keep 0 in public deployments. When 1, the hidden /api/cache/clear endpoint
# is enabled for local development.
EARTH_JUKEBOX_ALLOW_CACHE_CLEAR=0
